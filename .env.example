# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NÃO deve ir para o Git (já está no .gitignore).

# --- Desafio: Google Drive (opcional) ---
# Caminho do arquivo de credenciais OAuth baixado do Google Cloud Console
# (tipo "App para computador"). Veja o passo a passo no README.
GOOGLE_DRIVE_CREDENTIALS=credentials.json

# Nome da pasta que será criada no seu Google Drive
GOOGLE_DRIVE_FOLDER_NAME=OpenOffice Coworking - dados

# --- Outras opções (opcionais) ---
# Porta do servidor web (padrão 8080)
# PORT=8080

# Pasta onde ficam os arquivos JSON (padrão: data)
# OPENOFFICE_DATA_DIR=data
